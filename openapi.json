{
  "openapi": "3.0.3",
  "info": {
    "title": "Urja Meter Ops API",
    "version": "1.0.0",
    "description": "A clean REST API adapter over the Urja Meter Ops legacy portal. Consumers interact with this service without needing to know anything about the underlying legacy portal, its authentication mechanisms, or its internal SvelteKit formats."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Meters",
      "description": "Operations relating to electricity meters"
    },
    {
      "name": "Transformers",
      "description": "Distribution transformer operations"
    },
    {
      "name": "System",
      "description": "System health and status endpoints"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "description": "Returns operational status of the API adapter service without querying upstream.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api/meters": {
      "get": {
        "tags": ["Meters"],
        "summary": "Search meters",
        "description": "Search meters by identifier or attribute. Proxies portal search with domain-mapped responses.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search query string (meter ID, serial number, etc.)",
            "schema": {
              "type": "string",
              "maxLength": 100,
              "default": ""
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "1-based page index",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of matched meters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal error or invalid data shape",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Upstream authentication failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/meters/{id}": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get meter detail",
        "description": "Retrieves comprehensive meter metadata and its complete distribution network hierarchy.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Meter identifier (e.g. J100000)",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]{1,19}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter detail with full network hierarchy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid meter ID format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Meter not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal communication error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Upstream authentication failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/meters/{id}/consumption": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get meter energy consumption",
        "description": "Returns 30-minute interval telemetry readings including active energy (kWh), apparent energy (kVAh), and R-phase voltage.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Meter identifier (e.g. J100000)",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]{1,19}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of interval energy telemetry readings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnergyConsumptionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid meter ID format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Meter not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Upstream authentication failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/meters/{id}/location": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get meter geolocation",
        "description": "Returns GPS coordinates for the physical meter installation site.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Meter identifier (e.g. J100000)",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]{1,19}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GPS coordinates of the meter site",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterLocationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid meter ID format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Geolocation not found for meter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Upstream authentication failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/transformers": {
      "get": {
        "tags": ["Transformers"],
        "summary": "List distribution transformers",
        "description": "Returns paginated distribution transformers (DTs) across the grid.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "1-based page index",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated transformer list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransformerListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Upstream authentication failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "INVALID_PARAMETER"
              },
              "message": {
                "type": "string",
                "example": "page must be a positive integer"
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "MeterSummary": {
        "type": "object",
        "properties": {
          "meterId": { "type": "string", "example": "J100000" },
          "serialNo": { "type": "string", "example": "SE33962" },
          "make": { "type": "string", "example": "HPL" },
          "phaseType": { "type": "string", "example": "single" },
          "installationStatus": { "type": "string", "example": "Decommissioned" },
          "dtCode": { "type": "string", "example": "DT-001" }
        },
        "required": ["meterId", "serialNo", "make", "phaseType", "installationStatus", "dtCode"]
      },
      "MeterSearchResponse": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeterSummary"
            }
          }
        },
        "required": ["page", "results"]
      },
      "NetworkHierarchy": {
        "type": "object",
        "properties": {
          "zone": { "type": "string", "example": "Jaipur Zone 1 (Z-01)" },
          "circle": { "type": "string", "example": "Circle 1 (C-01)" },
          "division": { "type": "string", "example": "Division 1 (D-01)" },
          "subdivision": { "type": "string", "example": "Subdivision 1 (SD-01)" },
          "substation": { "type": "string", "example": "Substation 1 (SS-01)" },
          "feeder": { "type": "string", "example": "Feeder 1 (F-001)" },
          "transformer": { "type": "string", "example": "Malviya Nagar DT 1 (DT-001)" }
        },
        "required": ["zone", "circle", "division", "subdivision", "substation", "feeder", "transformer"]
      },
      "MeterDetailResponse": {
        "type": "object",
        "properties": {
          "meterId": { "type": "string", "example": "J100000" },
          "serialNo": { "type": "string", "example": "SE33962" },
          "make": { "type": "string", "example": "HPL" },
          "phaseType": { "type": "string", "example": "single" },
          "installationStatus": { "type": "string", "example": "Decommissioned" },
          "installationType": { "type": "string", "example": "Whole Current" },
          "network": {
            "$ref": "#/components/schemas/NetworkHierarchy"
          }
        },
        "required": ["meterId", "serialNo", "make", "phaseType", "installationStatus", "installationType", "network"]
      },
      "EnergyReading": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "example": "24/06/2026 00:00" },
          "kwh": { "type": "number", "example": 48439.16 },
          "kvah": { "type": "number", "example": 52314.29 },
          "voltageR": { "type": "number", "example": 229 }
        },
        "required": ["timestamp", "kwh", "kvah", "voltageR"]
      },
      "EnergyConsumptionResponse": {
        "type": "object",
        "properties": {
          "meterId": { "type": "string", "example": "J100000" },
          "readings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnergyReading"
            }
          }
        },
        "required": ["meterId", "readings"]
      },
      "MeterLocationResponse": {
        "type": "object",
        "properties": {
          "meterId": { "type": "string", "example": "J100000" },
          "latitude": { "type": "number", "example": 26.938961 },
          "longitude": { "type": "number", "example": 75.83095 }
        },
        "required": ["meterId", "latitude", "longitude"]
      },
      "Transformer": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "example": "DT-001" },
          "name": { "type": "string", "example": "Malviya Nagar DT 1" },
          "feederCode": { "type": "string", "example": "F-001" },
          "capacityKva": { "type": "number", "example": 100 }
        },
        "required": ["code", "name", "feederCode", "capacityKva"]
      },
      "TransformerListResponse": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "transformers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transformer"
            }
          }
        },
        "required": ["page", "transformers"]
      }
    }
  }
}
